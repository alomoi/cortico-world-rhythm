{
  "name": "cortico-world-rhythm",
  "version": "1.0.5",
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "description": "Coopanion 的作息扩展：让桌宠有自己的生活节律——什么时候安静、什么时候叫醒、睡觉与做梦。fork 自 cortico-world-selftalk 0.2.2。",
  "keywords": [
    "cortico-world",
    "cortico",
    "desktop-pet",
    "companion",
    "self-talk",
    "proactive",
    "daily-rhythm",
    "coopanion",
    "rhythm",
    "sleep",
    "dream"
  ],
  "author": {
    "name": "大肥鱼 (BigFatFish)"
  },
  "contributors": [
    {
      "name": "qwq-awa-qnq",
      "url": "https://github.com/qwq-awa-qnq"
    }
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qwq-awa-qnq/cortico-world-selftalk.git"
  },
  "homepage": "https://github.com/qwq-awa-qnq/cortico-world-selftalk#readme",
  "bugs": {
    "url": "https://github.com/qwq-awa-qnq/cortico-world-selftalk/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "describe.json",
    "icon.png",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run.ps1 check.mjs",
    "describe": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run.ps1 check.mjs --write",
    "smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run.ps1 smoke.mjs"
  },
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "作息",
    "tags": [
      "companion",
      "rhythm",
      "sleep",
      "dream"
    ],
    "describe": "describe.json",
    "icon": "icon.png",
    "locales": {
      "zh": {
        "displayName": "作息",
        "description": "让桌宠有自己的生活节律：安静后叫醒、睡觉与醒来、做梦、搭话意愿与场景感知。只给时机和事实，怎么回应由桌宠自己决定。"
      },
      "en": {
        "displayName": "Rhythm",
        "description": "Give your desktop pet a daily rhythm: wake-ups after quiet time, sleep and mornings, dreams, talking willingness and presence facts. Timing and facts only; the pet decides how to respond."
      }
    }
  }
}
