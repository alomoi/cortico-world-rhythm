{
  "name": "cortico-world-rhythm",
  "version": "1.0.7",
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "description": "Coopanion 的作息扩展：让桌宠有自己的生活节律——什么时候主动搭话、什么时候安静、什么时候睡觉和休息、有时还会做梦。fork 自 cortico-world-selftalk 0.2.2。",
  "keywords": [
    "cortico-world",
    "cortico",
    "desktop-pet",
    "companion",
    "self-talk",
    "proactive",
    "daily-rhythm",
    "coopanion",
    "rhythm",
    "sleep",
    "dream"
  ],
  "author": {
    "name": "大肥鱼 (BigFatFish)"
  },
  "contributors": [
    {
      "name": "qwq-awa-qnq",
      "url": "https://github.com/qwq-awa-qnq"
    }
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alomoi/cortico-world-rhythm.git"
  },
  "homepage": "https://github.com/alomoi/cortico-world-rhythm#readme",
  "bugs": {
    "url": "https://github.com/alomoi/cortico-world-rhythm/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "describe.json",
    "icon.png",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run.ps1 check.mjs",
    "describe": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run.ps1 check.mjs --write",
    "smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run.ps1 smoke.mjs"
  },
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "作息",
    "tags": [
      "companion",
      "rhythm",
      "sleep",
      "dream"
    ],
    "describe": "describe.json",
    "icon": "icon.png",
    "locales": {
      "zh": {
        "displayName": "作息",
        "description": "让桌宠有自己的生活节律——什么时候主动搭话、什么时候安静、什么时候睡觉和休息、有时还会做梦。只给时机和事实，怎么回应由桌宠自己决定。"
      },
      "en": {
        "displayName": "Rhythm",
        "description": "Give your desktop pet a daily rhythm — when to reach out, when to stay quiet, when to sleep and rest, and sometimes to dream. Timing and facts only; the pet decides how to respond."
      }
    }
  }
}
