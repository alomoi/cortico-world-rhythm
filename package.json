{
  "name": "cortico-world-rhythm",
  "version": "1.0.2",
  "type": "module",
  "private": true,
  "description": "Coopanion / Cortico 的作息 World：安静一段时间后叫醒 Coo，由它自己决定开不开口、用什么工具，慢慢过上自己的日子。（基于 cortico-world-selftalk 0.2.2 的 fork）",
  "keywords": [
    "cortico-world",
    "cortico",
    "desktop-pet",
    "companion",
    "self-talk",
    "proactive",
    "daily-rhythm"
  ],
  "author": "qwq-awa-qnq (upstream); fork maintained locally",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qwq-awa-qnq/cortico-world-selftalk.git"
  },
  "homepage": "https://github.com/qwq-awa-qnq/cortico-world-selftalk#readme",
  "bugs": {
    "url": "https://github.com/qwq-awa-qnq/cortico-world-selftalk/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "describe.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run.ps1 check.mjs",
    "describe": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run.ps1 check.mjs --write",
    "smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run.ps1 smoke.mjs"
  },
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "作息",
    "tags": [
      "companion"
    ],
    "describe": "describe.json"
  }
}
